# Database
DATABASE_URL=sqlite:///./store_intelligence.db

# API
API_V1_STR=/api/v1
PROJECT_NAME="Store Intelligence System"

# Authentication (P4.4)
# JWT_SECRET_KEY must be set to a real, random secret in any environment
# other than development -- the app refuses to start otherwise. Generate one
# with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
